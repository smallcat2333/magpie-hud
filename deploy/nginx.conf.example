# HTTPS termination for the loopback HUD server. SSE needs proxy_buffering off
# and a long read timeout; TLS enables Secure HttpOnly login cookies.
server {
    listen 443 ssl http2;
    server_name hud.example.com;

    ssl_certificate     /etc/letsencrypt/live/hud.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/hud.example.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 96k;

    location / {
        proxy_pass http://127.0.0.1:3435;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    location /api/v1/events {
        proxy_pass http://127.0.0.1:3435;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_buffering off;
        gzip off;
        proxy_read_timeout 1h;
        add_header X-Accel-Buffering no;
    }
}
