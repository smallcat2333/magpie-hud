# 收集 exe 与 Qt 插件的非系统 DLL，解决社区 Qt 的第三方动态库依赖。
cmake_minimum_required(VERSION 3.24...4.4)
set(CMAKE_GET_RUNTIME_DEPENDENCIES_PLATFORM "windows+pe")
set(CMAKE_GET_RUNTIME_DEPENDENCIES_TOOL "dumpbin")
find_program(CMAKE_GET_RUNTIME_DEPENDENCIES_COMMAND dumpbin REQUIRED)
file(GLOB_RECURSE DEPLOYED_DLLS "${DESTINATION}/*.dll")
file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES "${APP_EXE}"
    LIBRARIES ${DEPLOYED_DLLS}
    DIRECTORIES "${DESTINATION}" "${QT_BIN}"
    RESOLVED_DEPENDENCIES_VAR RESOLVED
    UNRESOLVED_DEPENDENCIES_VAR UNRESOLVED
    PRE_EXCLUDE_REGEXES "^[Aa][Pp][Ii]-[Mm][Ss]-" "^[Ee][Xx][Tt]-[Mm][Ss]-"
    POST_EXCLUDE_REGEXES ".*[/\\\\][Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\\\].*"
)
if(UNRESOLVED)
    message(FATAL_ERROR "Unresolved runtime DLLs: ${UNRESOLVED}")
endif()
foreach(DLL IN LISTS RESOLVED)
    get_filename_component(DLL_DIRECTORY "${DLL}" DIRECTORY)
    if(NOT DLL_DIRECTORY STREQUAL DESTINATION)
        file(COPY "${DLL}" DESTINATION "${DESTINATION}")
    endif()
endforeach()
